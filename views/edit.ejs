<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h2>Edit Your Chat : <%= chats._id%></h2>
    <p>This chat was sent from <%= chats.from%> to <%= chats.to %></p>
    <form method="post" action="/chats/<%=chats._id%>?_method=PUT">
        <textarea name="msg" rows="10" cols="50"><%=chats.msg%></textarea>
        <button>Edit</button>
    </form>
</body>
</html>